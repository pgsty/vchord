# A sphere reads only the lists that can hold a row inside it. Eight external centroids 10 apart on
# the axes of 64 dimensions, 1500 rows within 0.1 of each, half of them per owner, and two rows either
# side of the plane between the first two lists: `near` in the first list, `far` just across in the
# second. A sphere around `near` reaches the second list only from a radius between the two given.
# Rows are reranked from the table, so that the index blocks are routing's and the lists'.

statement ok
CREATE FUNCTION skip_v(k int, i int, s real) RETURNS vector IMMUTABLE LANGUAGE sql AS $$
  SELECT ARRAY(SELECT CASE WHEN j = k + 1 THEN 10 ELSE 0 END + s * sin(i * j + k) FROM generate_series(1, 64) j)::real[]::vector
$$;

statement ok
CREATE FUNCTION skip_pair(x real, y real) RETURNS vector IMMUTABLE LANGUAGE sql AS $$
  SELECT (ARRAY[x, y] || array_fill(0::real, ARRAY[62]))::vector
$$;

statement ok
CREATE TABLE skip_rows (id int, v vector(64), owner int);
INSERT INTO skip_rows SELECT k * 10000 + i, skip_v(k, i, 0.01), i % 2 FROM generate_series(0, 7) k, generate_series(1, 1500) i;
INSERT INTO skip_rows VALUES (0, skip_pair(6, 4), 1), (-1, skip_pair(4.9, 5.1), 1);
CREATE TABLE skip_centers (id integer, parent integer, vector vector(64));
INSERT INTO skip_centers SELECT k, NULL, skip_v(k, 0, 0) FROM generate_series(0, 7) k;

# Whether spheres of both radii around `near` return what a sequential scan does, and whether an
# exhaustive scan of the smaller reads fewer index blocks than one of the larger.
statement ok
CREATE FUNCTION skip_check(op text, cond text, small real, large real) RETURNS TABLE (same bool, fewer bool) LANGUAGE plpgsql AS $$
DECLARE r real; a int[]; b int[]; blocks bigint[] := '{}'; ok bool := true; stmt text; idx oid; before bigint;
BEGIN
  SELECT indexrelid INTO idx FROM pg_index WHERE indrelid = 'skip_rows'::regclass;
  FOREACH r IN ARRAY ARRAY[small, large] LOOP
    stmt := format('SELECT array_agg(id ORDER BY id) FROM skip_rows WHERE %s v %s sphere((SELECT v FROM skip_rows WHERE id = 0), %L::real)', cond, op, r);
    PERFORM set_config('enable_seqscan', 'off', true);
    PERFORM set_config('enable_indexscan', 'on', true);
    before := pg_stat_get_xact_blocks_fetched(idx);
    EXECUTE stmt INTO a;
    blocks := blocks || (pg_stat_get_xact_blocks_fetched(idx) - before);
    PERFORM set_config('enable_seqscan', 'on', true);
    PERFORM set_config('enable_indexscan', 'off', true);
    EXECUTE stmt INTO b;
    ok := ok AND a = b AND a = CASE WHEN r = small THEN ARRAY[0] ELSE ARRAY[-1, 0] END;
  END LOOP;
  RETURN QUERY SELECT ok, blocks[1] < blocks[2];
END
$$;

statement ok
CREATE INDEX skip_idx ON skip_rows USING vchordrq (v vector_l2_ops, owner) WITH (options = $$
rerank_in_table = true
[build.external]
table = 'public.skip_centers'
$$);

# Without a key, of the lists probed. `near` is 1.41 from the plane and 1.56 from `far`.
statement ok
SET vchordrq.probes = '8';

query TT
SELECT * FROM skip_check('<<->>', '', 1.3, 1.7);
----
t t

# With a key, the refill reads the lists the sphere reaches beyond the first probed, and no others.
statement ok
SET vchordrq.probes = '1';

query TT
SELECT * FROM skip_check('<<->>', 'owner = 1 AND', 1.3, 1.7);
----
t t

statement ok
DROP INDEX skip_idx;

# Two levels: every list routing chooses is read, as without a sphere.
statement ok
CREATE TABLE skip_tree (id integer, parent integer, vector vector(64));
INSERT INTO skip_tree SELECT 200, NULL, (SELECT ARRAY(SELECT CASE WHEN j <= 8 THEN 1.25 ELSE 0 END
  FROM generate_series(1, 64) j)::real[]::vector);
INSERT INTO skip_tree SELECT 100 + p, 200, (SELECT ARRAY(SELECT CASE WHEN j BETWEEN 4 * p + 1 AND 4 * p + 4 THEN 2.5 ELSE 0 END
  FROM generate_series(1, 64) j)::real[]::vector) FROM generate_series(0, 1) p;
INSERT INTO skip_tree SELECT k, 100 + k / 4, skip_v(k, 0, 0) FROM generate_series(0, 7) k;

statement ok
CREATE INDEX skip_idx ON skip_rows USING vchordrq (v vector_l2_ops, owner) WITH (options = $$
rerank_in_table = true
[build.external]
table = 'public.skip_tree'
$$);

statement ok
SET vchordrq.probes = '2,8';

query TT
SELECT * FROM skip_check('<<->>', '', 1.3, 1.7);
----
t f

statement ok
DROP INDEX skip_idx;

# Cosine, on the same directions: `near` is 0.2 radians from the plane and `far` 0.02 past it, so the
# sphere reaches the second list from a radius of 0.0197 and holds `far` from 0.0241.
statement ok
UPDATE skip_rows SET v = l2_normalize(v) WHERE id > 0;
UPDATE skip_rows SET v = skip_pair(cos(pi() / 4 - 0.2)::real, sin(pi() / 4 - 0.2)::real) WHERE id = 0;
UPDATE skip_rows SET v = skip_pair(cos(pi() / 4 + 0.02)::real, sin(pi() / 4 + 0.02)::real) WHERE id = -1;
UPDATE skip_centers SET vector = l2_normalize(vector);

statement ok
CREATE INDEX skip_idx ON skip_rows USING vchordrq (v vector_cosine_ops, owner) WITH (options = $$
rerank_in_table = true
[build.external]
table = 'public.skip_centers'
$$);

statement ok
SET vchordrq.probes = '8';

query TT
SELECT * FROM skip_check('<<=>>', '', 0.015, 0.03);
----
t t

statement ok
SET vchordrq.probes = '1';

query TT
SELECT * FROM skip_check('<<=>>', 'owner = 1 AND', 0.015, 0.03);
----
t t

statement ok
RESET vchordrq.probes;
DROP FUNCTION skip_check;
DROP TABLE skip_rows, skip_centers, skip_tree;
DROP FUNCTION skip_v, skip_pair;
