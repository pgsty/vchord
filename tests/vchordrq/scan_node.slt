# a count that needs no code to evaluate again: a generic plan's parameters, or a LATERAL value per row
statement ok
SET plan_cache_mode = force_generic_plan;
PREPARE sn_p(vector, int, int) AS SELECT id FROM sn ORDER BY v <=> $1 LIMIT $2 OFFSET $3;
CREATE FUNCTION sn_hint_p() RETURNS text LANGUAGE plpgsql AS $$
DECLARE plan json;
BEGIN
  EXECUTE $q$EXPLAIN (ANALYZE, FORMAT JSON) EXECUTE sn_p('[1,0,0]', 7, 2)$q$ INTO plan;
  RETURN jsonb_path_query_first(plan::jsonb, '$.**."Row Hint"') #>> '{}';
END $$;

query T
SELECT sn_hint_p();
----
exact 9

# a user's implicit cast is the user's code: the hint is not given
statement ok
CREATE FUNCTION sn_txt8(t text) RETURNS int8 LANGUAGE plpgsql IMMUTABLE AS $$ BEGIN RETURN t::numeric::int8; END $$;
CREATE CAST (text AS int8) WITH FUNCTION sn_txt8(text) AS IMPLICIT;
PREPARE sn_c(text) AS SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT $1;
CREATE OR REPLACE FUNCTION sn_hint_p() RETURNS text LANGUAGE plpgsql AS $$
DECLARE plan json;
BEGIN
  EXECUTE $q$EXPLAIN (ANALYZE, FORMAT JSON) EXECUTE sn_c('3')$q$ INTO plan;
  RETURN coalesce(jsonb_path_query_first(plan::jsonb, '$.**."Row Hint"') #>> '{}', 'none');
END $$;

query T
SELECT sn_hint_p();
----
none

statement ok
DEALLOCATE sn_p;
DEALLOCATE sn_c;
DROP FUNCTION sn_hint_p;
DROP CAST (text AS int8);
DROP FUNCTION sn_txt8;
RESET plan_cache_mode;

# so is a cast by a volatile built-in function
statement ok
CREATE CAST (name AS int8) WITH FUNCTION pg_tablespace_size(name) AS ASSIGNMENT;

query T
SELECT sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 'pg_default'::name$$);
----
none

statement ok
DROP CAST (name AS int8);

query T
SELECT sn_hint($$SELECT a.id, x.id FROM sn_asset a CROSS JOIN LATERAL
  (SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT a.owner) x WHERE a.id IN (5, 6)$$);
----
exact 6

# a function in LIMIT is not evaluated again: the hint is not given
statement ok
CREATE FUNCTION sn_k(n int) RETURNS int LANGUAGE plpgsql STABLE AS $$
BEGIN
  PERFORM set_config('sn.calls', (current_setting('sn.calls')::int + 1)::text, false);
  RETURN n;
END $$;
CREATE TABLE sn_calls (node bool, calls int);

statement ok
SET sn.calls = 0;
SET vchordrq.scan_node = off;
SELECT count(*) FROM (SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT sn_k(3)) s;
INSERT INTO sn_calls VALUES (false, current_setting('sn.calls')::int);
SET sn.calls = 0;
SET vchordrq.scan_node = on;
SELECT count(*) FROM (SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT sn_k(3)) s;
INSERT INTO sn_calls VALUES (true, current_setting('sn.calls')::int);

query BT
SELECT count(DISTINCT calls) = 1, sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT sn_k(3)$$) FROM sn_calls;
----
t none

statement ok
DROP TABLE sn_calls;
DROP FUNCTION sn_k;

# The scan returns the distance; the index scan below no longer computes it.
query T
EXPLAIN (VERBOSE, COSTS OFF) SELECT id, v <=> '[1,0,0]' AS d FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 3;
----
Limit
  Output: id, ((v <=> '[1,0,0]'::vector))
  ->  Custom Scan (VchordrqScan)
        Output: id, ((v <=> '[1,0,0]'::vector))
        ->  Index Scan using sn_v on public.sn
              Output: id
              Order By: (sn.v <=> '[1,0,0]'::vector)

query B
SELECT sn_same($$SELECT id, v <=> '[1,0,0]' AS d FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 50$$);
