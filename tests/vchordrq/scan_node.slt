# a filter between the Limit and the scan drops rows; a gating Result passes them, LockRows may drop
query TTT
SELECT sn_hint($$SELECT id FROM (SELECT id, random() r FROM sn ORDER BY v <=> '[1,0,0]') s WHERE r < 2 LIMIT 10$$),
  sn_hint($$SELECT id FROM sn WHERE current_setting('sn.x', true) IS NULL ORDER BY v <=> '[1,0,0]' LIMIT 10$$),
  sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 10 FOR UPDATE$$);
