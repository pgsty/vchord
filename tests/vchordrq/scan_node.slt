  sn_hint($$SELECT count(*) FROM (SELECT id FROM sn ORDER BY v <=> '[1,0,0]' OFFSET 5) s$$),
  sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT NULL$$);
