# The scan node: `col <op> q` above a vchordrq scan is the scan's distance; rows are as without it.

statement ok
CREATE TABLE sn (id int PRIMARY KEY, owner int, v vector(3));
INSERT INTO sn SELECT i, i % 7, ARRAY[sin(i), cos(i), sin(i * 0.7)]::real[]::vector
FROM generate_series(1, 3000) i;
CREATE TABLE sn_asset (id int PRIMARY KEY, owner int, visible bool);
INSERT INTO sn_asset SELECT i, i % 7, i % 3 <> 0 FROM generate_series(1, 3000) i;
CREATE TABLE sn_tag (id int, tag int);
INSERT INTO sn_tag SELECT i, j FROM generate_series(1, 3000) i, generate_series(1, 2) j;
CREATE INDEX sn_v ON sn USING vchordrq (v vector_cosine_ops);
ANALYZE sn, sn_asset, sn_tag;

statement ok
SET enable_seqscan = off;
SET enable_bitmapscan = off;
SET max_parallel_workers_per_gather = 0;

# rows of `q` with the node and without: the same ids in the same order, distances within rounding;
# plans a function in `q` caches are made again for each
statement ok
CREATE FUNCTION sn_same(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE a int[]; b int[]; x float8[]; y float8[];
BEGIN
  DISCARD PLANS;
  PERFORM set_config('vchordrq.scan_node', 'on', true);
  EXECUTE format('SELECT array_agg(id), array_agg(d) FROM (%s) r', q) INTO a, x;
  DISCARD PLANS;
  PERFORM set_config('vchordrq.scan_node', 'off', true);
  EXECUTE format('SELECT array_agg(id), array_agg(d) FROM (%s) r', q) INTO b, y;
  RETURN cardinality(a) > 0 AND a = b
    AND (SELECT bool_and(abs(i - j) < 1e-6) FROM unnest(x, y) u(i, j));
END $$;

# the plan of `q`, run
statement ok
CREATE FUNCTION sn_explain(q text) RETURNS jsonb LANGUAGE plpgsql AS $$
DECLARE plan json;
BEGIN
  EXECUTE 'EXPLAIN (ANALYZE, FORMAT JSON) ' || q INTO plan;
  RETURN plan::jsonb;
END $$;

# The Limit's rows the scan is told, as EXPLAIN ANALYZE shows them.
statement ok
CREATE FUNCTION sn_hint(q text) RETURNS text LANGUAGE sql AS $$
SELECT coalesce(jsonb_path_query_first(sn_explain(q), '$.**."Row Hint"') #>> '{}', 'none')
$$;

query T
SELECT sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 10 OFFSET 20$$);
----
exact 30

# auto_explain sets ANALYZE for an EXPLAIN with BUFFERS alone, which begins no scan (where it is built);
# PostgreSQL 19 crashes on this EXPLAIN itself, with the node off as well
skipif pg19
statement ok
DO $$
BEGIN
  BEGIN
    LOAD 'auto_explain';
  EXCEPTION WHEN undefined_file THEN
    RETURN;
  END;
  SET LOCAL auto_explain.log_min_duration = 0;
  SET LOCAL auto_explain.log_analyze = on;
  SET LOCAL auto_explain.log_nested_statements = on;
  EXECUTE $q$EXPLAIN (BUFFERS, COSTS OFF) SELECT id FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 5$q$;
END $$;

query T
SELECT sn_hint($$SELECT id FROM sn ORDER BY v <=> '[1,0,0]' FETCH FIRST 10 ROWS WITH TIES$$);
----
at least 11

query TT
SELECT sn_hint($$SELECT id FROM sn WHERE owner = 3 ORDER BY v <=> '[1,0,0]' LIMIT 10$$),
  sn_hint($$SELECT id FROM sn WHERE v <<=>> sphere('[1,0,0]'::vector, 0.5) ORDER BY v <=> '[1,0,0]' LIMIT 10$$);
----
at least 10 exact 10

