  ORDER BY v <=> '[1,0,0]' LIMIT 10$$),
  sn_hint($$SELECT id, row_number() OVER () FROM sn WHERE v <<=>> sphere('[1,0,0]'::vector, 0.5) LIMIT 3$$);
