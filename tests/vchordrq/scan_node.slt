  ORDER BY s.v <=> '[1,0,0]' LIMIT 10$$),
  sn_hint($$SELECT s.id FROM sn s JOIN sn_tag t ON t.id = s.id ORDER BY s.v <=> '[1,0,0]' LIMIT 10$$);
