# generic plans and cursors: a function's cached plan with its parameters, a cursor fetched by row
statement ok
CREATE FUNCTION sn_gen(q vector, k int, o int) RETURNS TABLE (id int, d float8) LANGUAGE plpgsql AS $$
BEGIN
  RETURN QUERY SELECT s.id, s.v <=> q FROM sn s JOIN sn_asset a ON a.id = s.id
    WHERE a.visible ORDER BY s.v <=> q LIMIT k OFFSET o;
END $$;
CREATE FUNCTION sn_cur() RETURNS TABLE (id int, d float8) LANGUAGE plpgsql AS $$
DECLARE c CURSOR FOR SELECT s.id, s.v <=> '[0,1,1]' FROM sn s ORDER BY s.v <=> '[0,1,1]';
BEGIN
  OPEN c;
  FOR i IN 1..8 LOOP
    FETCH c INTO id, d;
    RETURN NEXT;
  END LOOP;
  CLOSE c;
END $$;
SET plan_cache_mode = force_generic_plan;
SET enable_sort = off;

query BB
SELECT sn_same($$SELECT * FROM sn_gen('[1,0,1]', 5, 3)$$), sn_same($$SELECT * FROM sn_cur()$$);
----
t t

statement ok
RESET plan_cache_mode;
RESET enable_sort;
DROP FUNCTION sn_gen, sn_cur;

