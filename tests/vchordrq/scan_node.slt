# subtrees PostgreSQL's mutator visits bare (CASE arms, JSON formats), in the scan's list and above it
statement ok
CREATE FUNCTION sn_rows(q text) RETURNS bool LANGUAGE plpgsql AS $$
DECLARE a text; b text;
BEGIN
  PERFORM set_config('vchordrq.scan_node', 'on', true);
  EXECUTE format('SELECT string_agg(r::text, '','') FROM (%s) r', q) INTO a;
  PERFORM set_config('vchordrq.scan_node', 'off', true);
  EXECUTE format('SELECT string_agg(r::text, '','') FROM (%s) r', q) INTO b;
  RETURN a IS NOT NULL AND a = b;
END $$;

query BBBB
SELECT sn_rows($$SELECT id, CASE WHEN v <=> '[1,0,0]' < 0.05 THEN 'near' ELSE 'far' END FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 20$$),
  sn_rows($$SELECT id, CASE WHEN id > 5 THEN 'a' ELSE 'b' END FROM sn ORDER BY v <=> '[1,0,0]' LIMIT 20$$),
  sn_rows($$SELECT s.id, CASE WHEN a.visible THEN 'v' ELSE 'h' END FROM sn s JOIN sn_asset a ON a.id = s.id
    ORDER BY s.v <=> '[1,0,0]' LIMIT 20$$),
  sn_rows($$SELECT id FROM (SELECT id, owner FROM sn ORDER BY v <=> '[1,0,0]' OFFSET 0) s
    WHERE CASE WHEN id > 5 THEN owner < 4 ELSE true END LIMIT 20$$);
----
t t t t

