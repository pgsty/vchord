# The number of rows the executor will take from a vchordrq scan ("k"), and
# how it bounds them, as the scan node (src/index/vchordrq/node) hands it down.
# Each scan receives its hint when it starts returning rows, after every rescan.
# Needs a debug build: the function that reports the hints exists only with
# debug assertions.

statement ok
CREATE FUNCTION vchordrq_k_hints() RETURNS SETOF text
LANGUAGE c AS 'vchord', '_vchordrq_debug_k_hints_wrapper';

statement ok
CREATE TABLE k_asset (id int PRIMARY KEY, owner int, visible bool);
CREATE TABLE k_exif (asset_id int PRIMARY KEY, city text);
CREATE TABLE k_search (asset_id int PRIMARY KEY, owner int, e vector(4));
CREATE TABLE k_tag (asset_id int, tag int);
CREATE TABLE k_queries (id int, v vector(4), k int);
INSERT INTO k_asset SELECT i, i % 10, i % 3 <> 0 FROM generate_series(1, 5000) i;
INSERT INTO k_exif SELECT i, 'c' || (i % 50) FROM generate_series(1, 5000) i;
INSERT INTO k_search SELECT i, i % 10, ARRAY[sin(i), cos(i), sin(i * 0.7), cos(i * 1.3)]::real[]::vector
FROM generate_series(1, 5000) i;
INSERT INTO k_tag SELECT i, j FROM generate_series(1, 5000) i, generate_series(1, 3) j;
INSERT INTO k_queries VALUES (1, '[1,0,0,0]', 3), (2, '[0,1,0,0]', 5), (3, '[0,0,1,0]', 7);
CREATE TABLE k_nopk AS SELECT asset_id, e FROM k_search;
CREATE TABLE k_dead AS SELECT asset_id, e FROM k_search;
CREATE TABLE k_keyed AS SELECT asset_id, owner, e FROM k_search;
CREATE TABLE k_hashed AS SELECT asset_id, owner, e FROM k_search;
CREATE TABLE k_part (id int, e vector(4)) PARTITION BY RANGE (id);
CREATE TABLE k_part1 PARTITION OF k_part FOR VALUES FROM (0) TO (2500);
CREATE TABLE k_part2 PARTITION OF k_part FOR VALUES FROM (2500) TO (10000);
INSERT INTO k_part SELECT asset_id, e FROM k_search;

statement ok
CREATE INDEX ON k_search USING vchordrq (e vector_cosine_ops);
CREATE INDEX ON k_nopk USING vchordrq (e vector_cosine_ops);
CREATE INDEX ON k_dead USING vchordrq (e vector_cosine_ops);
CREATE INDEX ON k_keyed USING vchordrq (e vector_cosine_ops, owner);
CREATE INDEX ON k_hashed USING vchordrq (e vector_cosine_ops, owner int4_hash_ops);
CREATE INDEX ON k_part USING vchordrq (e vector_cosine_ops);
DELETE FROM k_dead WHERE asset_id IN (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 5);
ANALYZE k_asset, k_exif, k_search, k_tag, k_queries, k_nopk, k_dead, k_keyed, k_hashed, k_part;

statement ok
SET enable_seqscan = off;
SET enable_sort = off;
SET enable_bitmapscan = off;
SET enable_hashjoin = off;
SET enable_mergejoin = off;
SET max_parallel_workers_per_gather = 0;

statement ok
SELECT vchordrq_k_hints();

# Limit -> Index Scan

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10 OFFSET 20;

query T
SELECT vchordrq_k_hints();
----
exact 30

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 3 + 4;

query T
SELECT vchordrq_k_hints();
----
exact 7

# an initPlan in LIMIT is evaluated before the scan starts
statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT (SELECT max(k) FROM k_queries);

query T
SELECT vchordrq_k_hints();
----
exact 7

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 9223372036854775807 OFFSET 9223372036854775807;

query T
SELECT vchordrq_k_hints();
----
exact 18446744073709551614

# heap tuples deleted after the index build are skipped, not counted
statement ok
SELECT asset_id FROM k_dead ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10

# LIMIT 0 never starts the scan; OFFSET alone, LIMIT NULL and LIMIT ALL bound nothing

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 0;

query T
SELECT vchordrq_k_hints();
----

statement ok
SELECT count(*) FROM (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' OFFSET 5) s;

query T
SELECT vchordrq_k_hints();
----
unknown

statement ok
SELECT count(*) FROM (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT NULL) s;

query T
SELECT vchordrq_k_hints();
----
unknown

statement ok
SELECT count(*) FROM (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT ALL) s;

query T
SELECT vchordrq_k_hints();
----
unknown

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' FETCH FIRST 10 ROWS WITH TIES;

query T
SELECT vchordrq_k_hints();
----
at_least 11

# rows dropped by the executor: a qual on the scan, unless prefiltered, and the recheck of sphere keys;
# the scan node owns the sphere around the ORDER BY vector, which is not rechecked

statement ok
SELECT asset_id FROM k_search WHERE owner = 3 ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
at_least 10

statement ok
SET vchordrq.prefilter = on;
SELECT asset_id FROM k_search WHERE owner = 3 ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
SELECT asset_id FROM k_search WHERE owner = 3 AND e <<=>> sphere('[1,0,0,0]'::vector, 0.5) ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
RESET vchordrq.prefilter;

query T
SELECT vchordrq_k_hints();
----
exact 10
exact 10

statement ok
SELECT asset_id FROM k_search WHERE e <<=>> sphere('[1,0,0,0]'::vector, 0.5) ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
SELECT asset_id FROM k_search WHERE e <<=>> sphere('[0,1,0,0]'::vector, 1.5) ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10
at_least 10

# a filter key: rows are rechecked only where the index keeps hashes

statement ok
SELECT asset_id FROM k_keyed WHERE owner = 3 ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
SELECT asset_id FROM k_hashed WHERE owner = 3 ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10
at_least 10

statement ok
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10 FOR UPDATE;

query T
SELECT vchordrq_k_hints();
----
at_least 10

# joins above the scan

statement ok
SELECT count(*) FROM (SELECT a.id FROM k_search s JOIN k_asset a ON a.id = s.asset_id JOIN k_exif x ON x.asset_id = a.id
WHERE a.owner IN (1, 2, 3) AND a.visible ORDER BY s.e <=> '[1,0,0,0]' LIMIT 101 OFFSET 200) p;

query T
SELECT vchordrq_k_hints();
----
at_least 301

statement ok
SET plan_cache_mode = force_generic_plan;
PREPARE k_page(vector, int, int, int[]) AS SELECT a.id FROM k_search s JOIN k_asset a ON a.id = s.asset_id
JOIN k_exif x ON x.asset_id = a.id WHERE a.owner = ANY($4) AND a.visible ORDER BY s.e <=> $1 LIMIT $2 OFFSET $3;
EXECUTE k_page('[1,0,0,0]', 101, 200, '{1,2,3}');
DEALLOCATE k_page;
RESET plan_cache_mode;

query T
SELECT vchordrq_k_hints();
----
at_least 301

statement ok
SELECT s.asset_id, t.tag FROM k_search s JOIN k_tag t ON t.asset_id = s.asset_id ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
unknown

statement ok
SELECT s.asset_id, t.tag FROM k_search s LEFT JOIN k_tag t ON t.asset_id = s.asset_id ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
at_most 10

statement ok
SELECT s.asset_id FROM k_search s WHERE EXISTS (SELECT 1 FROM k_tag t WHERE t.asset_id = s.asset_id AND t.tag = 2)
ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
at_least 10

statement ok
SELECT s.asset_id, a.owner FROM k_search s LEFT JOIN k_asset a ON a.id = s.asset_id ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;
SELECT s.asset_id FROM k_search s WHERE NOT EXISTS (SELECT 1 FROM k_asset a WHERE a.id = s.asset_id AND a.visible)
ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10
at_least 10

statement ok
SET enable_nestloop = off;
SET enable_hashjoin = on;
SELECT a.id FROM k_nopk s JOIN k_asset a ON a.id = s.asset_id
WHERE s.e <<=>> sphere('[1,0,0,0]'::vector, 0.3) AND a.visible LIMIT 10;
SET enable_sort = on;
SELECT a.id FROM k_nopk s JOIN k_asset a ON a.id = s.asset_id
WHERE s.e <<=>> sphere('[1,0,0,0]'::vector, 0.3) AND a.visible ORDER BY s.e <=> '[1,0,0,0]' LIMIT 10;
SET enable_sort = off;
SET enable_hashjoin = off;
RESET enable_nestloop;

query T
SELECT vchordrq_k_hints();
----
at_least 10
unknown

# a scan on the inner side is rescanned for each outer row; the Limit bounds the total
statement ok
SELECT q.id, s.asset_id FROM k_queries q JOIN k_search s ON s.e <<=>> sphere(q.v, 0.05) LIMIT 4;

query T
SELECT DISTINCT h FROM vchordrq_k_hints() h;
----
unknown

# parameters, rescans and subqueries

statement ok
SET plan_cache_mode = force_generic_plan;
PREPARE k_param(vector, int, int) AS SELECT asset_id FROM k_search ORDER BY e <=> $1 LIMIT $2 OFFSET $3;
EXECUTE k_param('[1,0,0,0]', 7, 2);
EXECUTE k_param('[1,0,0,0]', 4, 1);
EXECUTE k_param('[1,0,0,0]', NULL, 1);
SET plan_cache_mode = force_custom_plan;
EXECUTE k_param('[1,0,0,0]', 7, 2);
DEALLOCATE k_param;
RESET plan_cache_mode;

query T
SELECT vchordrq_k_hints();
----
exact 9
exact 5
unknown
exact 9

statement ok
SELECT q.id, s.asset_id FROM k_queries q CROSS JOIN LATERAL (SELECT asset_id FROM k_search ORDER BY e <=> q.v LIMIT q.k) s;

query T
SELECT vchordrq_k_hints();
----
exact 3
exact 5
exact 7

statement ok
SELECT q.id, (SELECT asset_id FROM k_search ORDER BY e <=> q.v LIMIT 1) FROM k_queries q;

query T
SELECT vchordrq_k_hints();
----
exact 1
exact 1
exact 1

statement ok
SELECT * FROM (SELECT asset_id, e <=> '[1,0,0,0]' AS d FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10 OFFSET 5) s
WHERE s.asset_id % 2 = 0;

query T
SELECT vchordrq_k_hints();
----
exact 15

statement ok
SELECT * FROM (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]') s LIMIT 6;

query T
SELECT vchordrq_k_hints();
----
exact 6

# the nearest Limit governs
statement ok
SELECT * FROM (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 100) s LIMIT 3;

query T
SELECT vchordrq_k_hints();
----
exact 100

statement ok
WITH c AS MATERIALIZED (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]') SELECT * FROM c LIMIT 6;

query T
SELECT vchordrq_k_hints();
----
unknown

statement ok
WITH c AS NOT MATERIALIZED (SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]') SELECT * FROM c LIMIT 6;

query T
SELECT vchordrq_k_hints();
----
exact 6

statement ok
SET enable_sort = on;
SELECT asset_id FROM k_search WHERE e <<=>> sphere('[1,0,0,0]'::vector, 0.3) ORDER BY owner LIMIT 5;
SET enable_sort = off;

query T
SELECT vchordrq_k_hints();
----
unknown

# Append and MergeAppend: the other children share the Limit

statement ok
(SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 5)
UNION ALL (SELECT asset_id FROM k_search ORDER BY e <=> '[0,1,0,0]' LIMIT 7);

query T
SELECT vchordrq_k_hints();
----
exact 5
exact 7

statement ok
SELECT * FROM ((SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]')
UNION ALL (SELECT asset_id FROM k_search ORDER BY e <=> '[0,1,0,0]')) u LIMIT 4;

query T
SELECT vchordrq_k_hints();
----
at_most 4

statement ok
SELECT id FROM k_part ORDER BY e <=> '[1,0,0,0]' LIMIT 8;

query T
SELECT vchordrq_k_hints();
----
at_most 8
at_most 8

# cursors: FETCH has no Limit

statement ok
BEGIN;
DECLARE k_cursor CURSOR FOR SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 50;
FETCH 5 FROM k_cursor;
FETCH 5 FROM k_cursor;
DECLARE k_cursor_all CURSOR FOR SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]';
FETCH 5 FROM k_cursor_all;
COMMIT;

query T
SELECT vchordrq_k_hints();
----
exact 50
unknown

# parallel query: the leader runs the plan when no worker is available; a
# worker receives its own hint, which this backend does not see. A Limit above
# a Gather passes nothing below it, whose workers may lack what its count needs.

statement ok
SELECT set_config(CASE WHEN current_setting('server_version_num')::int >= 160000
  THEN 'debug_parallel_query' ELSE 'force_parallel_mode' END, 'on', false);
SET max_parallel_workers_per_gather = 2;
SET max_parallel_workers = 0;
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10

statement ok
RESET max_parallel_workers;
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
SELECT vchordrq_k_hints();
SELECT set_config(CASE WHEN current_setting('server_version_num')::int >= 160000
  THEN 'debug_parallel_query' ELSE 'force_parallel_mode' END, 'off', false);
SET max_parallel_workers_per_gather = 0;

# without the scan node, no hint
statement ok
SET vchordrq.scan_node = off;
SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;
RESET vchordrq.scan_node;

query T
SELECT vchordrq_k_hints();
----
unknown

# EXPLAIN alone never starts the scan

statement ok
EXPLAIN SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----

statement ok
EXPLAIN (ANALYZE) SELECT asset_id FROM k_search ORDER BY e <=> '[1,0,0,0]' LIMIT 10;

query T
SELECT vchordrq_k_hints();
----
exact 10

statement ok
RESET enable_seqscan;
RESET enable_sort;
RESET enable_bitmapscan;
RESET enable_hashjoin;
RESET enable_mergejoin;
RESET max_parallel_workers_per_gather;

statement ok
DROP TABLE k_asset, k_exif, k_search, k_tag, k_queries, k_nopk, k_dead, k_keyed, k_hashed, k_part;
DROP FUNCTION vchordrq_k_hints();
