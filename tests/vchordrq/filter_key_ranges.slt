# Ranges and NULL tests on filter keys return the heap's rows, before and after maintenance.

statement ok
CREATE TABLE fr (id int PRIMARY KEY, a int2, b int4, c int8, u uuid, v vector(3));

statement ok
INSERT INTO fr SELECT i,
  CASE WHEN i % 101 = 0 THEN NULL WHEN i % 89 = 0 THEN -32768 WHEN i % 83 = 0 THEN 32767
    ELSE (i * 7919) % 65536 - 32768 END,
  CASE WHEN i % 103 = 0 THEN NULL WHEN i % 997 = 0 THEN -2147483648 ELSE (i * 104729) % 1000 - 500 END,
  CASE WHEN i % 107 = 0 THEN NULL ELSE i::int8 * 1000000007 % 10000000000 - 5000000000 END,
  CASE WHEN i % 109 = 0 THEN NULL WHEN i % 113 = 0 THEN '00000000-0000-0000-0000-000000000000'
    ELSE md5(i::text)::uuid END,
  ARRAY[sin(i), cos(1.3 * i), sin(0.7 * i)]::real[]::vector
FROM generate_series(1, 6000) i;

statement ok
CREATE INDEX fr_v ON fr USING vchordrq (v vector_l2_ops, a, b, c, u) WITH (options = $$
residual_quantization = true
[build.internal]
lists = [4]
$$);

statement ok
SET enable_seqscan = off;

statement ok
SET enable_sort = off;

statement ok
SET vchordrq.probes = '4';

statement ok
CREATE FUNCTION fr_same(cond text) RETURNS boolean LANGUAGE plpgsql AS $$
DECLARE a int[]; b int[];
BEGIN
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM (SELECT id FROM fr WHERE %s '
    'ORDER BY v <-> ''[0.5,0.5,0.5]'') s', cond) INTO a;
  EXECUTE format('SELECT array_agg(id ORDER BY id) FROM fr WHERE (%s) IS TRUE', cond) INTO b;
  RETURN a IS NOT DISTINCT FROM b;
END
$$;

statement ok
CREATE FUNCTION fr_check() RETURNS text LANGUAGE sql AS $$
  SELECT coalesce(string_agg(c, '; '), 'all equal') FROM unnest(ARRAY[
    'a < 0', 'a <= -32768', 'a < -32768', 'a >= 32767', 'a > 32767', 'a < -30000', 'a BETWEEN -100 AND 100',
    'a > 5 AND a < 9 AND a <> 7', 'a >= 100 AND a <= 99', 'a < ANY(''{-20000,-10000}'')', 'a > ANY(''{30000,NULL}'')',
    'b < -499', 'b >= 499', 'b > 400 AND b < 450', 'b = ANY(''{1,2,3}'') AND b < 2', 'b <= -2147483648',
    'a < 70000', 'a > 70000', 'a >= -70000::int4', 'b < 5000000000::int8', 'b > 5000000000::int8',
    'b >= -9999999999::int8', 'b < -2147483647::int8', 'c BETWEEN -1::int2 AND 1000000::int4', 'c < 3::int2',
    'c > 4999999990', 'c >= -5000000000 AND c < -4000000000',
    'u >= ''80000000-0000-0000-0000-000000000000''', 'u < ''00000000-0000-0000-0000-000000000001''',
    'u BETWEEN ''40000000-0000-0000-0000-000000000000'' AND ''4fffffff-ffff-ffff-ffff-ffffffffffff''',
    'a < 0 AND b BETWEEN -100 AND 100', 'b < 0 AND c > 0 AND u > ''c0000000-0000-0000-0000-000000000000''',
    'a = 1 AND b > 0', 'a IS NULL', 'a IS NOT NULL', 'a IS NULL AND b < 0', 'u IS NULL', 'u IS NOT NULL AND a > 0',
    'b IS NULL AND c IS NULL', 'b IS NOT NULL AND b IS NULL'
  ]) c WHERE NOT fr_same(c)
$$;

query T
SELECT fr_check();
----
all equal

# the least int2 and the nil uuid are stored as zeros, as NULLs are, and told apart by the NULL mask
query T
SELECT bool_and(r) FROM (
  SELECT (SELECT count(*) FROM (SELECT id FROM fr WHERE a <= -32768 ORDER BY v <-> '[0.5,0.5,0.5]') s)
    = (SELECT count(*) FROM fr WHERE a = -32768) r
  UNION ALL SELECT (SELECT count(*) FROM (SELECT id FROM fr WHERE u <= '00000000-0000-0000-0000-000000000000'
    ORDER BY v <-> '[0.5,0.5,0.5]') s) = (SELECT count(*) FROM fr WHERE u = '00000000-0000-0000-0000-000000000000')
) s;
----
t

statement ok
INSERT INTO fr SELECT i + 10000, (i % 200 - 100)::int2, i % 50, i * 7, md5((i + 10000)::text)::uuid,
  ARRAY[cos(i), sin(0.3 * i), cos(0.9 * i)]::real[]::vector
FROM generate_series(1, 700) i;

query T
SELECT fr_check();
----
all equal

statement ok
DELETE FROM fr WHERE id % 7 = 3;

statement ok
VACUUM fr;

query T
SELECT fr_check();
----
all equal

# reading further lists once the probed one runs out, a range finds every row
statement ok
SET vchordrq.probes = '1';

query T
SELECT count(*) = (SELECT count(*) FROM fr WHERE b BETWEEN 10 AND 20)
FROM (SELECT id FROM fr WHERE b BETWEEN 10 AND 20 ORDER BY v <-> '[0.5,0.5,0.5]') s;
----
t

statement ok
SET vchordrq.probes = '4';

# a hashed key takes equality only: a range on it is a filter above the scan
statement ok
CREATE INDEX fr_h ON fr USING vchordrq (v vector_l2_ops, c int8_hash_ops) WITH (options = $$
residual_quantization = true
[build.internal]
lists = [4]
$$);

statement ok
DROP INDEX fr_v;

statement ok
CREATE FUNCTION fr_plan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE r record; s text := '';
BEGIN
  FOR r IN EXECUTE 'EXPLAIN (COSTS OFF) ' || q LOOP s := s || r."QUERY PLAN" || ' '; END LOOP;
  RETURN s;
END
$$;

query T
SELECT fr_plan('SELECT id FROM fr WHERE c = ANY(''{7,14,70}'') AND c < 50 ORDER BY v <-> ''[0.5,0.5,0.5]''')
  ~ 'Filter: .*\(c < 50\)';
----
t

query T
SELECT fr_same('c = 7 AND c < 100') AND fr_same('c = ANY(''{7, 14, 70}'') AND c >= 14');
----
t

statement ok
DROP TABLE fr;

statement ok
DROP FUNCTION fr_same, fr_check, fr_plan;

statement ok
RESET enable_seqscan;

statement ok
RESET enable_sort;

statement ok
RESET vchordrq.probes;
