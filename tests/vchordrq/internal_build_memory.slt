# Internal build: memory follows the data, not the upper bounds of the options.
#
# Every configuration here stays small even for builds without these checks
# (at most a few MiB of samples and centroids). Configurations that would have
# exhausted memory, such as `lists = [16777216]` on a tiny table, are covered by
# the unit tests of `vchordrq::build_memory` instead.

statement ok
CREATE TABLE t (val vector(256));

statement ok
INSERT INTO t (val)
SELECT ARRAY(SELECT random() + i * 0 FROM generate_series(1, 256))::real[]::vector
FROM generate_series(1, 10) s(i);

statement ok
SET maintenance_work_mem = '1MB';

# Ten rows but 2048 lists: the random centroids (2 MiB) do not fit in
# maintenance_work_mem, so the build fails before allocating them.

statement error clustering 10 sampled vectors into 2048 lists needs 2.00 MiB for centroids, which exceeds maintenance_work_mem \(1.00 MiB\)
CREATE INDEX ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [2048]
sampling_factor = 1
$$);

# the session is fine after the error
query I
SELECT count(*) FROM t;
----
10

# Fewer random centroids (512 KiB) still fit.

statement ok
CREATE INDEX t_512 ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [512]
sampling_factor = 1
$$);

statement ok
DROP INDEX t_512;

# With `kmeans_dimension`, the full-dimensional sums are counted as well.

statement ok
SET maintenance_work_mem = '4MB';

statement error clustering 10 sampled vectors into 2048 lists needs 4.27 MiB for centroids, which exceeds maintenance_work_mem \(4.00 MiB\)
CREATE INDEX ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [2048]
sampling_factor = 1
kmeans_dimension = 32
build_threads = 2
$$);

# The limit is maintenance_work_mem: raising it lets the same build run.

statement ok
SET maintenance_work_mem = '8MB';

statement ok
CREATE INDEX t_2048 ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [2048]
sampling_factor = 1
kmeans_dimension = 32
build_threads = 2
$$);

statement ok
SET vchordrq.probes = '16';

query I
SELECT count(*) FROM (SELECT val FROM t ORDER BY val <-> (SELECT val FROM t LIMIT 1) LIMIT 5) s;
----
5

statement ok
RESET vchordrq.probes;

statement ok
DROP INDEX t_2048;

# A large sampling_factor on a small table: the sample buffer is sized by the
# rows of the table (10), not by `lists * sampling_factor` (65536).

statement ok
SET maintenance_work_mem = '1MB';

statement ok
CREATE INDEX t_64 ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [64]
sampling_factor = 1024
$$);

statement ok
DROP INDEX t_64;

statement ok
DROP TABLE t;

# Builds with enough samples per list are not limited by maintenance_work_mem:
# 5000 sampled vectors (1.22 MiB) for 16 lists.

statement ok
CREATE TABLE t (val vector(64));

statement ok
INSERT INTO t (val)
SELECT ARRAY(SELECT random() + i * 0 FROM generate_series(1, 64))::real[]::vector
FROM generate_series(1, 5000) s(i);

statement ok
CREATE INDEX t_16 ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [16]
$$);

statement ok
DROP TABLE t;

# Multivectors: a row holds several vectors, so the sample buffer grows past
# the estimated number of rows.

statement ok
CREATE TABLE t (val vector(8)[]);

statement ok
INSERT INTO t (val)
SELECT ARRAY(
    SELECT ARRAY(SELECT random() + i * 0 + j * 0 FROM generate_series(1, 8))::real[]::vector
    FROM generate_series(1, 100) s(j)
)
FROM generate_series(1, 3) s(i);

statement ok
CREATE INDEX t_multi ON t USING vchordrq (val vector_maxsim_ops)
WITH (options = $$
[build.internal]
lists = [4]
$$);

statement ok
SET vchordrq.probes = '4';

query I
SELECT count(*) FROM (SELECT val FROM t ORDER BY val @# (SELECT val FROM t LIMIT 1) LIMIT 3) s;
----
3

statement ok
RESET vchordrq.probes;

statement ok
DROP TABLE t;

statement ok
RESET maintenance_work_mem;
