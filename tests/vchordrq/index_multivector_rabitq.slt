statement ok
DROP INDEX pg_temp.ti;

statement ok
CREATE INDEX ti ON pg_temp.t USING vchordrq ((pg_temp.quantize_to_rabitq4(val)::rabitq4(64)[2]) rabitq4_maxsim_ops);

# Default MaxSim uses approximate scores. Check the selected set, then compare
# refined ordering with a sequential scan below.
query I
SELECT index FROM (
SELECT index FROM pg_temp.t ORDER BY
pg_temp.quantize_to_rabitq4(val)::rabitq4(64)[] @# ARRAY[
    quantize_to_rabitq4(array_cat(ARRAY[0.6, 0.8], ARRAY(SELECT 0.0 FROM generate_series(1, 62)))::vector),
    quantize_to_rabitq4(array_cat(ARRAY[0.3, 0.4], ARRAY(SELECT 0.0 FROM generate_series(1, 62)))::vector)
]
LIMIT 10
) AS nearest ORDER BY index;
----
79
174
194
239
537
919
1207
1639
1821
1920

statement ok
CREATE FUNCTION pg_temp.check_rabitq4_maxsim() RETURNS boolean
LANGUAGE plpgsql
SET vchordrq.maxsim_refine = 4096
SET enable_seqscan = off
SET enable_indexscan = on
SET enable_bitmapscan = off
AS $$
DECLARE
    q text := $query$
SELECT index FROM pg_temp.t ORDER BY
pg_temp.quantize_to_rabitq4(val)::rabitq4(64)[] @# ARRAY[
    quantize_to_rabitq4(array_cat(ARRAY[0.6, 0.8], ARRAY(SELECT 0.0 FROM generate_series(1, 62)))::vector),
    quantize_to_rabitq4(array_cat(ARRAY[0.3, 0.4], ARRAY(SELECT 0.0 FROM generate_series(1, 62)))::vector)
]
LIMIT 10
$query$;
    indexed integer[];
    sequential integer[];
    plan jsonb;
BEGIN
    EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO plan;
    IF NOT jsonb_path_exists(plan, '$.** ? (@."Node Type" == "Index Scan" && @."Index Name" == "ti")') THEN
        RETURN false;
    END IF;
    EXECUTE 'SELECT array_agg(index) FROM (' || q || ') ranked' INTO indexed;
    PERFORM set_config('enable_indexscan', 'off', true);
    PERFORM set_config('enable_seqscan', 'on', true);
    EXECUTE 'EXPLAIN (FORMAT JSON) ' || q INTO plan;
    IF NOT jsonb_path_exists(plan, '$.** ? (@."Node Type" == "Seq Scan")') THEN
        RETURN false;
    END IF;
    EXECUTE 'SELECT array_agg(index) FROM (' || q || ') ranked' INTO sequential;
    RETURN indexed = sequential;
END
$$;

query T
SELECT pg_temp.check_rabitq4_maxsim();
----
t

statement ok
DROP INDEX pg_temp.ti;

