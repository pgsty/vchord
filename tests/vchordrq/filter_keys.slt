statement ok
CREATE FUNCTION fk_recheck(cond text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE plan json; node json;
BEGIN
  EXECUTE format('EXPLAIN (ANALYZE, TIMING OFF, SUMMARY OFF, FORMAT JSON) SELECT id FROM fk '
    'WHERE %s ORDER BY v <-> ''[0.5,0.5,0.5]''', cond) INTO plan;
  node := plan -> 0 -> 'Plan';
  WHILE node ->> 'Node Type' <> 'Index Scan' LOOP
    node := node -> 'Plans' -> 0;
  END LOOP;
  RETURN (node ->> 'Actual Rows')::numeric::int || ' returned, '
    || coalesce((node ->> 'Rows Removed by Index Recheck')::int, 0) || ' removed by the recheck';
END
$$;

statement ok
CREATE FUNCTION fk_subsets(conds text[]) RETURNS text LANGUAGE plpgsql AS $$
DECLARE n int := array_length(conds, 1); m int; cond text; bad text := '';
BEGIN
  FOR m IN 1..(1 << n) - 1 LOOP
    SELECT string_agg(conds[i], ' AND ') INTO cond FROM generate_series(1, n) i WHERE m >> (i - 1) & 1 = 1;
    IF NOT fk_same(cond) THEN
      bad := bad || cond || E'\n';
    END IF;
  END LOOP;
  RETURN coalesce(nullif(bad, ''), 'all equal');
END
$$;

statement ok
CREATE INDEX fk_whole ON fk USING vchordrq (v vector_l2_ops, u, i4, i2) WITH (options = $$
residual_quantization = true
[build.internal]
lists = [16]
$$);

