# Full index scans with filter keys return the heap's rows.

statement ok
CREATE TABLE fk (id int PRIMARY KEY, owner uuid, grp int4, note text, u uuid NOT NULL, un uuid, i2 int2,
  i4 int4 NOT NULL, i8 int8, v vector(3));

statement ok
INSERT INTO fk SELECT i,
  CASE WHEN i % 100 = 0 THEN NULL
       ELSE ('00000000-0000-0000-0000-' || lpad((i % 10)::text, 12, '0'))::uuid END,
  i % 7, NULL,
  ('00000000-0000-0000-0000-' || lpad((i % 50)::text, 12, '0'))::uuid,
  CASE WHEN i % 100 = 0 THEN NULL ELSE ('00000000-0000-0000-0000-' || lpad((i % 7)::text, 12, '0'))::uuid END,
  CASE WHEN i % 100 = 1 THEN NULL ELSE (i % 301 - 150)::int2 END,
  i % 1000,
  CASE WHEN i % 100 = 2 THEN NULL ELSE (i % 37)::int8 * 1000000000000 END,
  ARRAY[(i % 97) / 97.0, (i % 89) / 89.0, (i % 83) / 83.0]::real[]::vector
FROM generate_series(1, 30000) i;

