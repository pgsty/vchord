# An ORDER BY scan with a sphere around the ORDER BY vector ends at the radius.

statement ok
SET enable_seqscan = off;

statement ok
CREATE TABLE rq_sphere_order (id int, v vector(3));

statement ok
INSERT INTO rq_sphere_order
SELECT i, x FROM (
  SELECT i, ARRAY[sin(i), cos(1.3 * i), sin(0.7 * i)]::real[]::vector AS x
  FROM generate_series(1, 1000) i
) s;

statement ok
CREATE INDEX rq_sphere_order_l2 ON rq_sphere_order USING vchordrq (v vector_l2_ops)
WITH (options = $$
[build.internal]
lists = []
$$);

statement ok
CREATE INDEX rq_sphere_order_ip ON rq_sphere_order USING vchordrq (v vector_ip_ops)
WITH (options = $$
[build.internal]
lists = []
$$);

statement ok
SET vchordrq.probes = '';

query T
EXPLAIN (COSTS OFF)
SELECT id FROM rq_sphere_order WHERE v <<->> sphere('[0.5, 0.5, 0.5]'::vector, 0.2)
ORDER BY v <-> '[0.5, 0.5, 0.5]' LIMIT 5;
----
Limit
  ->  Index Scan using rq_sphere_order_l2 on rq_sphere_order
        Index Cond: (v <<->> '("[0.5,0.5,0.5]",0.2)'::sphere_vector)
        Order By: (v <-> '[0.5,0.5,0.5]'::vector)

query T
SELECT ARRAY(SELECT id FROM rq_sphere_order WHERE v <<->> sphere('[0.5, 0.5, 0.5]'::vector, 0.2)
ORDER BY v <-> '[0.5, 0.5, 0.5]' LIMIT 5);
----
{629,252}

query T
SELECT ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <-> '[0.5, 0.5, 0.5]' LIMIT 5) s
WHERE v <-> '[0.5, 0.5, 0.5]' < 0.2);
----
{629,252}

# No row past the radius reaches the recheck.
statement ok
CREATE FUNCTION rq_sphere_order_rechecked(q text) RETURNS bigint LANGUAGE plpgsql AS $$
DECLARE
  r text;
  result bigint := 0;
BEGIN
  FOR r IN EXECUTE 'EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF) ' || q LOOP
    IF r LIKE '%Rows Removed by Index Recheck%' THEN
      result := result + substring(r FROM '\d+')::bigint;
    END IF;
  END LOOP;
  RETURN result;
END
$$;

query II
SELECT
  rq_sphere_order_rechecked($q$SELECT id FROM rq_sphere_order WHERE v <<->> sphere('[0.5, 0.5, 0.5]'::vector, 0.2)
    ORDER BY v <-> '[0.5, 0.5, 0.5]' LIMIT 5$q$),
  rq_sphere_order_rechecked($q$SELECT id FROM rq_sphere_order WHERE v <<#>> sphere('[0.5, 0.5, 0.5]'::vector, -1.35)
    ORDER BY v <#> '[0.5, 0.5, 0.5]' LIMIT 5$q$);
----
0 0

# A sphere around another vector does not bound the scan.
query I
SELECT rq_sphere_order_rechecked($q$SELECT id FROM rq_sphere_order WHERE v <<->> sphere('[0.5, 0.5, 0.5]'::vector, 0.2)
  ORDER BY v <-> '[0, 0, 0]' LIMIT 5$q$) > 0;
----
t

# Per block: mismatches with the two ORDER BY forms, empty spheres, overfull spheres.

statement ok
CREATE TABLE rq_sphere_order_q AS
SELECT j, ARRAY[cos(j), sin(1.7 * j), cos(0.3 * j)]::real[]::vector AS q FROM generate_series(1, 40) j;

statement ok
CREATE VIEW rq_sphere_order_l2_cmp AS
SELECT
  ARRAY(SELECT id FROM rq_sphere_order WHERE v <<->> sphere(q, r)
        ORDER BY v <-> q LIMIT 5) AS a,
  ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <-> q) s
        WHERE v <-> q < r LIMIT 5) AS b,
  ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <-> q LIMIT 5) s
        WHERE v <-> q < r) AS c,
  (SELECT count(*) FROM (SELECT v FROM rq_sphere_order ORDER BY v <-> q LIMIT 6) s
   WHERE v <-> q < r) AS n
FROM rq_sphere_order_q, (VALUES (0.05::real), (0.2), (0.4)) r(r);

query IIII
SELECT count(*) FILTER (WHERE a <> b), count(*) FILTER (WHERE a <> c), count(*) FILTER (WHERE n = 0), count(*) FILTER (WHERE n > 5)
FROM rq_sphere_order_l2_cmp;
----
0 0 39 60

query IIII
SELECT count(*) FILTER (WHERE a <> b), count(*) FILTER (WHERE a <> c), count(*) FILTER (WHERE n = 0), count(*) FILTER (WHERE n > 5)
FROM (
  SELECT
    ARRAY(SELECT id FROM rq_sphere_order WHERE v <<#>> sphere(q, r)
          ORDER BY v <#> q LIMIT 5) AS a,
    ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <#> q) s
          WHERE v <#> q < r LIMIT 5) AS b,
    ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <#> q LIMIT 5) s
          WHERE v <#> q < r) AS c,
    (SELECT count(*) FROM (SELECT v FROM rq_sphere_order ORDER BY v <#> q LIMIT 6) s
     WHERE v <#> q < r) AS n
  FROM rq_sphere_order_q, (VALUES (-1.6::real), (-1.2), (-0.8)) r(r)
) s;
----
0 0 22 98

query T
SELECT ARRAY(SELECT id FROM rq_sphere_order WHERE v <<->> sphere('[0.5, 0.5, 0.5]'::vector, 0.3)
ORDER BY v <-> '[0, 0, 0]' LIMIT 4);
----
{252,629,315,692}

query T
SELECT ARRAY(SELECT id FROM (SELECT id, v FROM rq_sphere_order ORDER BY v <-> '[0, 0, 0]') s
WHERE v <-> '[0.5, 0.5, 0.5]' < 0.3 LIMIT 4);
----
{252,629,315,692}

statement ok
DROP TABLE rq_sphere_order_q CASCADE;

statement ok
DROP FUNCTION rq_sphere_order_rechecked;

statement ok
DROP TABLE rq_sphere_order;

statement ok
CREATE TABLE rq_sphere_edge (id int, v vector(16), tenant int);
INSERT INTO rq_sphere_edge VALUES
  (1, (ARRAY[6.9999995::real] || array_fill(0.000665::real, ARRAY[15]))::vector, 1),
  (2, (ARRAY[7::real] || array_fill(0::real, ARRAY[15]))::vector, 1),
  (3, (ARRAY[7.0000005::real] || array_fill(0::real, ARRAY[15]))::vector, 1);
CREATE VIEW rq_sphere_edge_hits AS SELECT id FROM rq_sphere_edge WHERE tenant=1
  AND v <<->> sphere(array_fill(0::real, ARRAY[16])::vector, 7.0)
  ORDER BY v <-> array_fill(0::real, ARRAY[16])::vector;

query I
TABLE rq_sphere_edge_hits;
----
1

statement ok
SET enable_seqscan=off;
SET vchordrq.epsilon=4;
CREATE INDEX rq_sphere_edge_idx ON rq_sphere_edge USING vchordrq (v vector_l2_ops);

query I
TABLE rq_sphere_edge_hits;
----
1

statement ok
DROP INDEX rq_sphere_edge_idx;
SET vchordrq.probes='1';
CREATE INDEX rq_sphere_edge_idx ON rq_sphere_edge USING vchordrq (v vector_l2_ops, tenant)
  WITH (options='rerank_in_table=true
build.internal.lists=[2]');

query I
TABLE rq_sphere_edge_hits;
