# CREATE INDEX, REINDEX and VACUUM report real tuple and page counts. They used
# to report zeros, which reset the table's reltuples to 0.

statement ok
CREATE TABLE t (id integer, val vector(3)) WITH (autovacuum_enabled = false);

statement ok
INSERT INTO t (id, val)
SELECT i, ARRAY[random(), random(), random()]::real[] FROM generate_series(1, 5000) s(i);

statement ok
INSERT INTO t (id, val) SELECT i, NULL FROM generate_series(5001, 5100) s(i);

statement ok
ANALYZE t;

statement ok
CREATE INDEX t_idx ON t USING vchordrq (val vector_l2_ops)
WITH (options = $$
[build.internal]
lists = [4]
$$);

# NULLs are not indexed: the heap has 5100 rows, the index 5000 tuples.
query TI
SELECT relname, reltuples::bigint FROM pg_class WHERE relname IN ('t', 't_idx') ORDER BY relname;
----
t 5100
t_idx 5000

# PostgreSQL 18+ EXPLAIN ANALYZE reports Index Searches across scans and rescans.
statement ok
SET enable_seqscan = off;

statement ok
SET vchordrq.probes = '4';

skipif pg15
skipif pg16
skipif pg17
query T
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT id FROM t ORDER BY val <-> '[0.5, 0.5, 0.5]' LIMIT 3;
----
Limit (actual rows=3.00 loops=1)
  ->  Index Scan using t_idx on t (actual rows=3.00 loops=1)
        Order By: (val <-> '[0.5,0.5,0.5]'::vector)
        Index Searches: 1

skipif pg15
skipif pg16
skipif pg17
query T
EXPLAIN (ANALYZE, COSTS OFF, TIMING OFF, SUMMARY OFF, BUFFERS OFF)
SELECT s.id FROM (VALUES ('[0.1,0.1,0.1]'::vector), ('[0.5,0.5,0.5]'::vector), ('[0.9,0.9,0.9]'::vector)) AS q(qv)
CROSS JOIN LATERAL (SELECT id FROM t ORDER BY val <-> q.qv LIMIT 2) AS s;
----
Nested Loop (actual rows=6.00 loops=1)
  ->  Values Scan on "*VALUES*" (actual rows=3.00 loops=1)
  ->  Limit (actual rows=2.00 loops=3)
        ->  Index Scan using t_idx on t (actual rows=2.00 loops=3)
              Order By: (val <-> "*VALUES*".column1)
              Index Searches: 3

# pg_stat_user_indexes.idx_scan tracks vchordrq index scans and rescans across PG 15-19.
statement ok
DO $$
DECLARE
    before_scans bigint;
    after_single bigint;
    after_lateral bigint;
BEGIN
    before_scans := pg_stat_get_xact_numscans('t_idx'::regclass);
    PERFORM id FROM t ORDER BY val <-> '[0.5, 0.5, 0.5]' LIMIT 3;
    after_single := pg_stat_get_xact_numscans('t_idx'::regclass);
    IF after_single - before_scans <> 1 THEN
        RAISE EXCEPTION 'expected +1 xact numscans for single scan, got %', after_single - before_scans;
    END IF;
    PERFORM s.id
    FROM (VALUES ('[0.1,0.1,0.1]'::vector), ('[0.5,0.5,0.5]'::vector), ('[0.9,0.9,0.9]'::vector)) AS q(qv)
    CROSS JOIN LATERAL (SELECT id FROM t ORDER BY val <-> q.qv LIMIT 2) AS s;
    after_lateral := pg_stat_get_xact_numscans('t_idx'::regclass);
    IF after_lateral - after_single <> 3 THEN
        RAISE EXCEPTION 'expected +3 xact numscans for lateral rescan, got %', after_lateral - after_single;
    END IF;
END
$$;

statement ok
SELECT pg_stat_force_next_flush();

statement ok
SELECT pg_stat_clear_snapshot();

query B
SELECT pg_stat_get_numscans('t_idx'::regclass) >= 4;
----
t

statement ok
RESET vchordrq.probes;

statement ok
RESET enable_seqscan;

statement ok
REINDEX INDEX t_idx;

query TI
SELECT relname, reltuples::bigint FROM pg_class WHERE relname IN ('t', 't_idx') ORDER BY relname;
----
t 5100
t_idx 5000

# a parallel build sums the counts of all participants

statement ok
SET max_parallel_maintenance_workers = 2;

statement ok
ALTER TABLE t SET (parallel_workers = 2);

statement ok
REINDEX INDEX t_idx;

query TI
SELECT relname, reltuples::bigint FROM pg_class WHERE relname IN ('t', 't_idx') ORDER BY relname;
----
t 5100
t_idx 5000

statement ok
RESET max_parallel_maintenance_workers;

statement ok
ALTER TABLE t RESET (parallel_workers);

# VACUUM reports the remaining index tuples and the number of pages.

statement ok
DELETE FROM t WHERE id <= 1000;

# A catalog autovacuum can hold a snapshot from before the DELETE even though
# this table disables autovacuum. Wait until those rows can be removed; forcing
# INDEX_CLEANUP alone cannot make tuples visible to old snapshots removable.
query B retry 100 backoff 100ms
SELECT NOT EXISTS (
    SELECT FROM pg_stat_activity
    WHERE pid <> pg_backend_pid() AND backend_xmin IS NOT NULL AND age(backend_xmin) > 0
);
----
t

statement ok
VACUUM (INDEX_CLEANUP ON) t;

query TIB
SELECT relname, reltuples::bigint, relpages > 0 FROM pg_class WHERE relname IN ('t', 't_idx') ORDER BY relname;
----
t 4100 t
t_idx 4000 t

query B
SELECT relpages = pg_relation_size('t_idx') / current_setting('block_size')::int FROM pg_class WHERE relname = 't_idx';
----
t

statement ok
DROP TABLE t;

# A multivector index counts vectors, the heap counts rows.

statement ok
CREATE TABLE t (val vector(3)[]) WITH (autovacuum_enabled = false);

statement ok
INSERT INTO t (val)
SELECT ARRAY[
    ARRAY[random(), random(), random()]::real[]::vector,
    ARRAY[random(), random(), random()]::real[]::vector,
    ARRAY[random(), random(), random()]::real[]::vector
] FROM generate_series(1, 100);

statement ok
ANALYZE t;

statement ok
CREATE INDEX t_idx ON t USING vchordrq (val vector_maxsim_ops);

query TI
SELECT relname, reltuples::bigint FROM pg_class WHERE relname IN ('t', 't_idx') ORDER BY relname;
----
t 100
t_idx 300

statement ok
DROP TABLE t;
