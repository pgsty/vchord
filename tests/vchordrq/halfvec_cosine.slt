# halfvec cosine: a table rerank measures rows from the query as given, as the operator does.

statement ok
CREATE TABLE hc (id int PRIMARY KEY, h halfvec(8));
INSERT INTO hc SELECT i, (SELECT array_agg(cos(i * 0.373 * j + j))::real[] FROM generate_series(1, 8) j)::halfvec
FROM generate_series(1, 5000) i;
CREATE INDEX ON hc USING vchordrq (h halfvec_cosine_ops) WITH (options = $$
rerank_in_table = true
[build.internal]
lists = []
$$);

statement ok
SET enable_seqscan = off;

query B
SELECT bool_and(d >= l - 1e-7) FROM (SELECT d, lag(d) OVER () l FROM
(SELECT h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' d FROM hc ORDER BY h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' LIMIT 1000) s) s;
----
t

# the scan node hands up that distance: the operator's, to f32 rounding
query B
SELECT max(abs(n - o)) < 1e-6 FROM (SELECT h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' n,
  '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]'::halfvec <=> h o FROM hc ORDER BY h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' LIMIT 2000) s;
----
t

# with the normalized copies in the index, the scan is left alone: one statement, one precision
statement ok
CREATE TABLE hci AS SELECT * FROM hc;
CREATE INDEX ON hci USING vchordrq (h halfvec_cosine_ops) WITH (options = $$
[build.internal]
lists = []
$$);

query II
SELECT (SELECT count(*) FROM hci WHERE h <<=>> sphere('[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]'::halfvec, r)),
  (SELECT count(*) FROM hci WHERE ('[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]'::halfvec <=> h) < r)
FROM unnest('{0.255}'::real[]) r;
----
19 19

query I
SELECT count(*) FILTER (WHERE d >= 0.2555) FROM (SELECT h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' d FROM hci
  WHERE (h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]') < 0.2555 ORDER BY h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' LIMIT 100) s;
----
0

statement ok
CREATE TABLE hci_on AS SELECT h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' d FROM hci ORDER BY h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' LIMIT 50;
SET vchordrq.scan_node = off;
CREATE TABLE hci_off AS SELECT h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' d FROM hci ORDER BY h <=> '[0.5,-0.3,0.8,0.1,-0.6,0.2,0.4,-0.1]' LIMIT 50;
RESET vchordrq.scan_node;

query B
SELECT (SELECT array_agg(d ORDER BY d) FROM hci_on) = (SELECT array_agg(d ORDER BY d) FROM hci_off);
----
t

statement ok
RESET enable_seqscan;

statement ok
DROP TABLE hc, hci, hci_on, hci_off;
