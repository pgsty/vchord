# Residual vchordrq adds the query-centroid distance (`dis_f`) to every
# candidate's lower bound. Here each row is its own centroid, so its residual is
# zero, its RaBitQ error term is zero, and its lower bound is exactly `dis_f`.
# Exact distances to [1.015625,0.017333984]: row 2 = 1.0111307, row 1 =
# 1.0111518. Rounding the difference to f16 moves `dis_f` by up to ~1e-3, far
# more than that gap. If an approximate routing distance reached the bound, the
# reranker would emit row 1 before row 2 is visited: wrong LIMIT 1, rows out of
# order, and a sphere qual that stops before reaching row 2.

statement ok
CREATE TABLE halfvec_residual_bound (id int, v halfvec(2));

statement ok
INSERT INTO halfvec_residual_bound VALUES
  (1, '[0.004825592,-0.009361267]'), (2, '[0.004928589,0.046966553]');

statement ok
CREATE TABLE halfvec_residual_bound_c (id int, parent int, vector halfvec(2));

statement ok
INSERT INTO halfvec_residual_bound_c SELECT id, NULL, v FROM halfvec_residual_bound;

statement ok
CREATE INDEX halfvec_residual_bound_idx ON halfvec_residual_bound
USING vchordrq (v halfvec_l2_ops) WITH (options = 'residual_quantization = true
[build.external]
table = "public.halfvec_residual_bound_c"');

# The same rows reach the second index through the insert path.
statement ok
CREATE TABLE halfvec_residual_bound_i (id int, v halfvec(2));

statement ok
CREATE INDEX halfvec_residual_bound_i_idx ON halfvec_residual_bound_i
USING vchordrq (v halfvec_l2_ops) WITH (options = 'residual_quantization = true
[build.external]
table = "public.halfvec_residual_bound_c"');

statement ok
INSERT INTO halfvec_residual_bound_i SELECT * FROM halfvec_residual_bound;

statement ok
SET enable_seqscan = off;

statement ok
SET enable_bitmapscan = off;

# All lists are probed, so the candidate set is complete and the answer exact.
statement ok
SET vchordrq.probes = '2';

query I
SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1.015625,0.017333984]'::halfvec LIMIT 1;
----
2

query I
SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1.015625,0.017333984]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_residual_bound
WHERE v <<->> sphere('[1.015625,0.017333984]'::halfvec, 1.01114);
----
2

query I
SELECT id FROM halfvec_residual_bound_i ORDER BY v <-> '[1.015625,0.017333984]'::halfvec LIMIT 1;
----
2

query I
SELECT id FROM halfvec_residual_bound_i ORDER BY v <-> '[1.015625,0.017333984]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_residual_bound_i
WHERE v <<->> sphere('[1.015625,0.017333984]'::halfvec, 1.01114);
----
2

# With one probe, approximate routing may pick either list (an ANN trade-off);
# exactly one row comes back either way.
statement ok
SET vchordrq.probes = '1';

query I
SELECT count(*) FROM (
  SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1.015625,0.017333984]'::halfvec LIMIT 2
) s;
----
1

statement ok
RESET vchordrq.probes;

statement ok
RESET enable_bitmapscan;

statement ok
RESET enable_seqscan;

statement ok
DROP TABLE halfvec_residual_bound, halfvec_residual_bound_i, halfvec_residual_bound_c;
