# Residual vchordrq scales `dis_f` down by the worst-case f16 rounding factor
# so approximate routing distances remain sound lower bounds even when a row
# equals its centroid (zero residual, zero RaBitQ error term).
# Distances to [1.0, 0.0]: row 2 = 1.0, row 1 = 1.02 (well above f16 rounding).

statement ok
CREATE TABLE halfvec_residual_bound (id int, v halfvec(2));

statement ok
INSERT INTO halfvec_residual_bound VALUES
  (1, '[-0.02,0]'), (2, '[0,0]');

statement ok
CREATE TABLE halfvec_residual_bound_c (id int, parent int, vector halfvec(2));

statement ok
INSERT INTO halfvec_residual_bound_c SELECT id, NULL, v FROM halfvec_residual_bound;

statement ok
CREATE INDEX halfvec_residual_bound_idx ON halfvec_residual_bound
USING vchordrq (v halfvec_l2_ops) WITH (options = 'residual_quantization = true
[build.external]
table = "public.halfvec_residual_bound_c"');

# The same rows reach the second index through the insert path.
statement ok
CREATE TABLE halfvec_residual_bound_i (id int, v halfvec(2));

statement ok
CREATE INDEX halfvec_residual_bound_i_idx ON halfvec_residual_bound_i
USING vchordrq (v halfvec_l2_ops) WITH (options = 'residual_quantization = true
[build.external]
table = "public.halfvec_residual_bound_c"');

statement ok
INSERT INTO halfvec_residual_bound_i SELECT * FROM halfvec_residual_bound;

statement ok
SET enable_seqscan = off;

statement ok
SET enable_bitmapscan = off;

# All lists are probed, so the candidate set is complete.
statement ok
SET vchordrq.probes = '2';

query I
SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1,0]'::halfvec LIMIT 1;
----
2

query I
SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1,0]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_residual_bound
WHERE v <<->> sphere('[1,0]'::halfvec, 1.01);
----
2

query I
SELECT id FROM halfvec_residual_bound_i ORDER BY v <-> '[1,0]'::halfvec LIMIT 1;
----
2

query I
SELECT id FROM halfvec_residual_bound_i ORDER BY v <-> '[1,0]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_residual_bound_i
WHERE v <<->> sphere('[1,0]'::halfvec, 1.01);
----
2

# With one probe, the nearest centroid is probed and returns row 2.
statement ok
SET vchordrq.probes = '1';

query I
SELECT count(*) FROM (
  SELECT id FROM halfvec_residual_bound ORDER BY v <-> '[1,0]'::halfvec LIMIT 2
) s;
----
1

statement ok
RESET vchordrq.probes;

statement ok
RESET enable_bitmapscan;

statement ok
RESET enable_seqscan;

statement ok
DROP TABLE halfvec_residual_bound, halfvec_residual_bound_i, halfvec_residual_bound_c;
