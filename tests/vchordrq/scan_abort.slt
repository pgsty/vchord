# Raise inside the prefilter expression, while HeapTuple is live.
statement ok
BEGIN;
DECLARE bad NO SCROLL CURSOR FOR
  SELECT id FROM vchordrq_scan_abort WHERE vchordrq_scan_abort_error(id) > 0 ORDER BY v <-> '[0,0,0]' LIMIT 10;
SAVEPOINT s;

statement error intentional scan error
FETCH 1 FROM bad;

statement ok
ROLLBACK TO s;
CLOSE bad;
COMMIT;
RESET vchordrq.prefilter;

# MaxSim uses the same Scanner owner but builds a different iterator tree.
statement ok
CREATE TABLE scan_abort_maxsim (id int, v vector(3)[]);
INSERT INTO scan_abort_maxsim SELECT id, ARRAY[v] FROM vchordrq_scan_abort;
CREATE INDEX scan_abort_maxsim_idx ON scan_abort_maxsim USING vchordrq (v vector_maxsim_ops);

statement ok
DO $$
DECLARE plan json;
BEGIN
  EXECUTE 'EXPLAIN (FORMAT JSON) SELECT vchordrq_scan_abort_error(id) FROM scan_abort_maxsim ORDER BY v @# ARRAY[''[1,1,1]''::vector] LIMIT 10' INTO plan;
  IF plan->0->'Plan'->'Plans'->0->>'Index Name' IS DISTINCT FROM 'scan_abort_maxsim_idx' THEN
    RAISE EXCEPTION 'expected MaxSim index scan: %', plan;
  END IF;
END $$;

statement ok
BEGIN;
DECLARE bad NO SCROLL CURSOR FOR
  SELECT vchordrq_scan_abort_error(id) FROM scan_abort_maxsim ORDER BY v @# ARRAY['[1,1,1]'::vector] LIMIT 10;
SAVEPOINT s;

statement error intentional scan error
FETCH 1 FROM bad;

statement ok
ROLLBACK TO s;
CLOSE bad;
COMMIT;
DROP TABLE scan_abort_maxsim;

# Explicit buffer-only cleanup also runs on PG17+.
statement ok
SET vchordrq.io_search = 'read_buffer';
SET vchordrq.io_rerank = 'read_buffer';

statement ok
DO $$
DECLARE c refcursor; x int;
BEGIN
  OPEN c FOR SELECT vchordrq_scan_abort_error(id) FROM vchordrq_scan_abort ORDER BY v <-> '[0,0,0]' LIMIT 10;
  BEGIN
    FETCH c INTO x;
  EXCEPTION WHEN SQLSTATE 'P0001' THEN
    IF SQLERRM <> 'intentional scan error' THEN RAISE; END IF;
  END;
  CLOSE c;
END $$;

query I
SELECT id FROM vchordrq_scan_abort ORDER BY v <-> '[0,0,0]' LIMIT 1;
----
1

# All failures above must preserve this backend and its session state.
query I
SELECT (pid = pg_backend_pid())::int FROM scan_abort_backend;
----
1

statement ok
DROP TABLE vchordrq_scan_abort;
DROP TABLE scan_abort_backend;
DROP FUNCTION vchordrq_scan_abort_error(int);
DROP FUNCTION vchordrq_scan_abort_cancel(int);
RESET vchordrq.io_search;
RESET vchordrq.io_rerank;
RESET enable_seqscan;
