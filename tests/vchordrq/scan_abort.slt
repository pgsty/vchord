# Prefilter forces heap fetching even with index rerank.
statement ok
SET vchordrq.prefilter = on;

# S1: the parent portal outlives the failed subtransaction, then CLOSE runs.
statement ok
BEGIN;
DECLARE bad NO SCROLL CURSOR FOR SELECT vchordrq_scan_abort_error(id) FROM vchordrq_scan_abort WHERE id > 0 ORDER BY v <-> '[0,0,0]' LIMIT 10;
SAVEPOINT s;

statement error intentional scan error
FETCH 1 FROM bad;

statement ok
ROLLBACK TO s;

statement error portal "bad" cannot be run
FETCH 1 FROM bad;

statement ok
ROLLBACK TO s;
CLOSE bad;
COMMIT;

