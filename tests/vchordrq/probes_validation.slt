# Both session settings and index fallback settings use the same parser.
statement ok
SET enable_seqscan = off;

statement ok
CREATE TABLE probes_validation (v vector(3));

statement ok
INSERT INTO probes_validation VALUES ('[1,2,3]'), ('[2,3,4]');

# Upstream 1.1.1 accepted one trailing comma, so dumps may contain it.
statement ok
CREATE INDEX probes_validation_trailing_idx ON probes_validation USING vchordrq (v vector_l2_ops)
WITH (options = 'build.internal.lists = [2, 2]', probes = '2,2,');

query I
SELECT count(*) FROM (SELECT v FROM probes_validation ORDER BY v <-> '[0,0,0]' LIMIT 2) s;
----
2

statement ok
DROP INDEX probes_validation_trailing_idx;

