# Hold the leader on its first heap tuple until two workers have joined and a
# worker has processed the only HOT update, near the end of the table.
statement ok
CREATE FUNCTION hot_locks(leader int, phase int) RETURNS int
LANGUAGE sql VOLATILE PARALLEL SAFE AS $$
  SELECT count(DISTINCT pid)::int FROM pg_locks
  WHERE locktype = 'advisory' AND classid = leader::oid AND objid = phase::oid AND granted
$$;
CREATE FUNCTION hot_wait(leader int, phase int, participants int) RETURNS void
LANGUAGE plpgsql VOLATILE PARALLEL SAFE AS $$
DECLARE deadline timestamptz := clock_timestamp() + interval '45 seconds';
BEGIN
  WHILE public.hot_locks(leader, phase) < participants LOOP
    IF clock_timestamp() >= deadline THEN RAISE EXCEPTION 'HOT build timed out at phase %', phase; END IF;
    PERFORM pg_sleep(0.01);
  END LOOP;
END $$;
CREATE FUNCTION hot_vector(id int, v vector) RETURNS vector
LANGUAGE plpgsql IMMUTABLE PARALLEL SAFE AS $$
DECLARE leader int := nullif(current_setting('hot_test.leader', true), '')::int;
BEGIN
  IF pg_backend_pid() <> nullif(current_setting('hot_test.serial_pid', true), '')::int THEN
    RAISE EXCEPTION 'unexpected parallel worker during serial fallback';
  END IF;
  IF leader IS NULL OR public.hot_locks(leader, 4) > 0 THEN RETURN v; END IF;
  IF pg_backend_pid() = leader THEN
    PERFORM public.hot_wait(leader, 1, 2);
    PERFORM pg_advisory_xact_lock_shared(leader, 2);
    PERFORM public.hot_wait(leader, 3, 1);
    PERFORM pg_advisory_xact_lock_shared(leader, 4);
  ELSE
    PERFORM pg_advisory_xact_lock_shared(leader, 1);
    PERFORM public.hot_wait(leader, 2, 1);
    IF id = 4000 THEN
      PERFORM pg_advisory_xact_lock_shared(leader, 3);
      PERFORM public.hot_wait(leader, 4, 1);
    END IF;
  END IF;
  RETURN v;
END $$;

statement ok
CREATE TABLE hot_rq (id int, v vector(2), pad text) WITH (fillfactor=50, autovacuum_enabled=false, parallel_workers=2);
CREATE TABLE hot_g (LIKE hot_rq) WITH (fillfactor=50, autovacuum_enabled=false, parallel_workers=2);
INSERT INTO hot_rq SELECT id, CASE id WHEN 1 THEN '[1,0]'::vector WHEN 4000 THEN '[0,0]'::vector END,
  repeat('x', 200) FROM generate_series(1, 4000) id;
INSERT INTO hot_g SELECT * FROM hot_rq;
CREATE FUNCTION hot_plan(tab text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE plan json;
BEGIN
  EXECUTE format('EXPLAIN (FORMAT JSON, COSTS OFF) SELECT id FROM %I ORDER BY hot_vector(id,v)::vector(2) <-> ''[0,0]'' LIMIT 1', tab) INTO plan;
  RETURN plan::text;
END $$;

