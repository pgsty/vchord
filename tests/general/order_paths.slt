CREATE VIEW order_expr_nulls AS SELECT id FROM order_rows WHERE v IS NULL
  ORDER BY l2_normalize(v)::vector(2) <#> '[1,0]' LIMIT 10;
CREATE INDEX order_expr_rq ON order_rows USING vchordrq ((l2_normalize(v)::vector(2)) vector_ip_ops);

