statement ok
CREATE TABLE order_rows (id int, v vector(2));
INSERT INTO order_rows VALUES (1,'[1,0]'), (2,'[-1,0]'), (3,'[2,0]');
INSERT INTO order_rows SELECT id,NULL FROM generate_series(4,708) id;
ANALYZE order_rows;
SET enable_seqscan=off;
SET enable_sort=off;
SET plan_cache_mode=force_generic_plan;
CREATE FUNCTION order_plan(q text) RETURNS text LANGUAGE plpgsql AS $$
DECLARE plan json;
BEGIN
  EXECUTE 'EXPLAIN (COSTS OFF, FORMAT JSON) ' || q INTO plan;
  RETURN plan::text;
END $$;
CREATE VIEW order_nulls AS SELECT id FROM order_rows WHERE v IS NULL ORDER BY v <-> '[0,0]';
CREATE VIEW order_mixed_nulls AS SELECT id FROM order_rows WHERE v IS NULL OR id=1 ORDER BY v <-> '[0,0]';
CREATE VIEW order_null_join AS SELECT r.id FROM order_rows r JOIN (VALUES (NULL::vector), ('[1,0]')) p(v)
  ON r.v IS NOT DISTINCT FROM p.v ORDER BY r.v <-> '[0,0]';
CREATE VIEW order_two AS SELECT id FROM order_rows ORDER BY v <-> '[0,0]', v <-> '[-2,0]' LIMIT 2;
CREATE VIEW order_one AS SELECT id FROM order_rows ORDER BY v <-> '[-1,0]' LIMIT 1;
PREPARE parameter_order(vector) AS SELECT id FROM order_rows ORDER BY v <-> $1 LIMIT 2;
PREPARE parameter_order_count(vector) AS SELECT count(*) FROM (SELECT id FROM order_rows ORDER BY v <-> $1 LIMIT 2) s;
PREPARE parameter_all(vector) AS SELECT count(*), count(DISTINCT id), count(v) FROM
  (SELECT id,v FROM order_rows ORDER BY v <-> $1) s;
PREPARE parameter_sphere(vector) AS SELECT array_agg(id ORDER BY id) FROM
  (SELECT id FROM order_rows WHERE v <<->> sphere('[0,0]'::vector,1.5) ORDER BY v <-> $1) s;
CREATE VIEW order_rescans AS SELECT array_agg(n ORDER BY i) FROM
  (VALUES (1,NULL::vector),(2,'[-1,0]'::vector),(3,NULL::vector)) inputs(i,q)
  CROSS JOIN LATERAL (SELECT count(*) AS n FROM
    (SELECT id FROM order_rows ORDER BY v <-> q LIMIT 4) result) counts;
CREATE INDEX order_rq_idx ON order_rows USING vchordrq (v vector_l2_ops);
UPDATE order_rows SET id=1000 WHERE id=4;

query ITT
SELECT count(*), order_plan('TABLE order_nulls') NOT LIKE '%order_rq_idx%',
  order_plan('TABLE order_one') LIKE '%order_rq_idx%' FROM order_nulls;
----
705 t t

query IITT
SELECT (SELECT count(*) FROM order_mixed_nulls), (SELECT count(*) FROM order_null_join),
  order_plan('TABLE order_mixed_nulls') NOT LIKE '%order_rq_idx%',
  order_plan('TABLE order_null_join') NOT LIKE '%order_rq_idx%';
----
706 706 t t

