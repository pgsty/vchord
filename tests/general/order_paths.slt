ALTER TABLE order_rows ADD COLUMN owner int;
UPDATE order_rows SET owner=id%2;
CREATE INDEX order_key_idx ON order_rows USING vchordrq (v vector_l2_ops, owner) WHERE id<10;
PREPARE parameter_key(vector) AS SELECT array_agg(id ORDER BY id) FROM
  (SELECT id FROM order_rows WHERE id<10 AND owner=1 ORDER BY v <-> $1) s;

