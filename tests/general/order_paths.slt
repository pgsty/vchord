CREATE TABLE order_multis (id int, v vector(2)[]);
INSERT INTO order_multis VALUES (1,ARRAY['[1,0]'::vector]), (2,NULL), (3,NULL);
CREATE INDEX order_multis_idx ON order_multis USING vchordrq (v vector_maxsim_ops);
PREPARE parameter_multi(vector[]) AS SELECT count(*) FROM (SELECT id FROM order_multis ORDER BY v @# $1 LIMIT 2) s;

