----
0

query I
SELECT count(*) FROM cz_v WHERE v <<=>> sphere('[0,0]'::vector, 2);
----
0

statement ok
RESET enable_seqscan;

statement ok
DROP INDEX cz_v_idx;

statement ok
DROP TABLE cz_v;

