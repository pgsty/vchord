# Cosine is undefined for zero norms. Both operand orders and sphere use it.

query T
SELECT (quantize_to_rabitq8('[0,0]'::vector) <=> quantize_to_rabitq8('[1,0]'::vector))::text;
----
NaN

query T
SELECT (quantize_to_rabitq8('[1,0]'::vector) <=> quantize_to_rabitq8('[0,0]'::vector))::text;
----
NaN

query T
SELECT (quantize_to_rabitq8('[0,0]'::vector) <=> quantize_to_rabitq8('[0,0]'::vector))::text;
----
NaN

query T
SELECT quantize_to_rabitq8('[0,0]'::vector) <<=>> sphere(quantize_to_rabitq8('[1,0]'::vector), 2);
----
f

query T
SELECT (quantize_to_rabitq4('[0,0]'::vector) <=> quantize_to_rabitq4('[1,0]'::vector))::text;
----
NaN

query T
SELECT (quantize_to_rabitq4('[1,0]'::vector) <=> quantize_to_rabitq4('[0,0]'::vector))::text;
----
NaN

query T
SELECT (quantize_to_rabitq4('[0,0]'::vector) <=> quantize_to_rabitq4('[0,0]'::vector))::text;
----
NaN

query T
SELECT quantize_to_rabitq4('[0,0]'::vector) <<=>> sphere(quantize_to_rabitq4('[1,0]'::vector), 2);
----
f

statement ok
CREATE TABLE cz_v AS SELECT id, v AS v FROM (VALUES (0,'[0,0]'::vector),(1,'[1,0]'::vector),(2,'[0,1]'::vector)) q(id,v);

statement ok
ALTER TABLE cz_v ALTER v TYPE vector(2);

statement ok
CREATE INDEX cz_v_idx ON cz_v USING vchordrq (v vector_cosine_ops);

statement ok
SET enable_seqscan = off;

query I
SELECT count(*) FROM (SELECT * FROM cz_v ORDER BY v <=> '[0,0]'::vector LIMIT 5) q;
----
0

query I
SELECT count(*) FROM cz_v WHERE v <<=>> sphere('[0,0]'::vector, 2);
----
0

statement ok
RESET enable_seqscan;

statement ok
DROP INDEX cz_v_idx;

statement ok
CREATE INDEX cz_v_idx ON cz_v USING vchordg (v vector_cosine_ops);

statement ok
SET enable_seqscan = off;

query I
