# Rounding the difference to f16 reverses these two neighbors. ANN routing may
# use that approximation, but final reranking and sphere quals must not.

statement ok
CREATE TABLE halfvec_rerank_precision (id int, v halfvec(2));

statement ok
INSERT INTO halfvec_rerank_precision VALUES
  (1, '[-0.00048828125,0]'), (2, '[0,0.025]');

statement ok
CREATE INDEX halfvec_rerank_rq ON halfvec_rerank_precision USING vchordrq (v halfvec_l2_ops)
WITH (options = '[build.internal]
lists = []');

statement ok
SET enable_seqscan = off;

query I
SELECT id FROM halfvec_rerank_precision ORDER BY v <-> '[1,0]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_rerank_precision
WHERE v <<->> sphere('[1,0]'::halfvec, 1.0004);
----
2

statement ok
DROP INDEX halfvec_rerank_rq;

statement ok
CREATE INDEX halfvec_rerank_g ON halfvec_rerank_precision USING vchordg (v halfvec_l2_ops);

query I
SELECT id FROM halfvec_rerank_precision ORDER BY v <-> '[1,0]'::halfvec LIMIT 2;
----
2
1

query I
SELECT id FROM halfvec_rerank_precision
WHERE v <<->> sphere('[1,0]'::halfvec, 1.0004);
----
2

statement ok
DROP TABLE halfvec_rerank_precision;

statement ok
RESET enable_seqscan;
